{
  "name": "session-chains",
  "version": "0.1.3",
  "description": "DSH 交接鏈面板：把互相交接的對話依「鏈」聚在一起、編號、一鍵切換，並在上下文到門檻時提醒或自動交接。",
  "type": "module",
  "main": "./plugin/index.mjs",
  "exports": {
    ".": {
      "default": "./plugin/index.mjs"
    },
    "./client": {
      "default": "./plugin/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "plugin",
    "cordis.patch.yml"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "plugin",
    "session",
    "handoff",
    "context",
    "token"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HildebrandYu/dsh-session-chains.git"
  },
  "homepage": "https://github.com/HildebrandYu/dsh-session-chains#readme",
  "license": "MIT",
  "dependencies": {}
}
